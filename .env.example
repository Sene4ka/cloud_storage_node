# Server Configuration
SERVER_PORT_EXTERNAL=8080
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespwd
DB_NAME=cloud_storage
DB_SSLMODE=disable

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispwd
REDIS_DB=0

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=minio_server_hostname_or_ip:9000
MINIO_ACCESS_KEY=minioaccesskey # MinIO login
MINIO_SECRET_KEY=miniosecretkey # MinIO password
MINIO_USE_SSL=false
MINIO_BUCKET=cloud-storage
MINIO_REGION=ru-central-1

# JWT Configuration
JWT_SECRET=your-secret-key
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

#SMTP
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_EMAIL_ADDRESS=from@example.com
SMTP_USERNAME=your_smtp_app_username
SMTP_PASSWORD=your_smtp_app_password

# Environment
NODE_ENV=production
MAIL_MOCK=false